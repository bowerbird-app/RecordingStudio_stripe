<% content_for :head do %>
  <%= stylesheet_link_tag "recording_studio_stripe/button", "data-turbo-track": "reload" %>
<% end %>
<% recording_studio_page_nav(title: "Billing", page_nav_anchor_url: main_app.root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Billing",
    subtitle: billing_subtitle(@lines),
    variant: :h1
  ) %>

  <% if @waiting_on_stripe %>
    <%= render FlatPack::Alert::Component.new(
      description: "Stripe is confirming this plan. Refresh in a moment.",
      style: :info,
      class: "mb-4"
    ) %>
  <% elsif @confirming_allowance %>
    <%= render FlatPack::Alert::Component.new(
      description: "Stripe is confirming that pack. Refresh in a moment.",
      style: :info,
      class: "mb-4"
    ) %>
  <% end %>

  <div class="flex flex-wrap gap-2">
    <% if @show_manage_billing %>
      <%= button_to recording_studio_stripe.portal_path, class: "inline-flex", form: { data: { turbo: false } } do %>
        <%= render FlatPack::Button::Component.new(
          text: "Manage billing on Stripe",
          icon: "credit-card",
          style: :stripe,
          size: :md,
          type: "submit"
        ) %>
      <% end %>
    <% end %>
    <%= render FlatPack::Button::Component.new(
      text: "See usage",
      style: :secondary,
      size: :md,
      href: recording_studio_stripe.usage_path
    ) %>
  </div>

  <% if @lines.any? %>
    <% @lines.each do |line| %>
      <% if RecordingStudioStripe::SubscriptionTypes.configured? %>
        <%= render FlatPack::SectionTitle::Component.new(title: line.label) %>
      <% end %>
      <%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg) do %>
        <%= render RecordingStudioStripe::CurrentPlanComponent.new(
          subscription: line.subscription,
          can_manage: @show_manage_billing
        ) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No plan yet",
      description: "Pick a plan when you’re ready.",
      icon: :inbox
    ) do |empty| %>
      <% empty.slot do %>
        <%= render FlatPack::Button::Component.new(text: "See plans", style: :primary, size: :md, href: main_app.plans_path) %>
      <% end %>
    <% end %>
  <% end %>
</div>
