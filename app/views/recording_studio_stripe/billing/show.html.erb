<% content_for :head do %>
  <%= stylesheet_link_tag "recording_studio_stripe/button", "data-turbo-track": "reload" %>
<% end %>
<% content_for :title, t("recording_studio.stripe.billing.title") %>
<% content_for :subtitle, billing_subtitle(@lines) %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  anchor_href: main_app.root_path,
  anchor_tooltip: t("recording_studio.stripe.nav.close")
) %>

<div class="flex w-full flex-col gap-6">
  <% if @waiting_on_stripe %>
    <%= render FlatPack::Alert::Component.new(
      description: t("recording_studio.stripe.billing.confirming_plan"),
      style: :info,
      class: "mb-4"
    ) %>
  <% elsif @confirming_allowance %>
    <%= render FlatPack::Alert::Component.new(
      description: t("recording_studio.stripe.billing.confirming_pack"),
      style: :info,
      class: "mb-4"
    ) %>
  <% end %>

  <% if @show_manage_billing || @show_see_usage %>
    <div class="flex flex-wrap gap-2">
      <% if @show_manage_billing %>
        <%= button_to recording_studio_stripe.portal_path, class: "inline-flex", form: { data: { turbo: false } } do %>
          <%= render FlatPack::Button::Component.new(
            text: t("recording_studio.stripe.billing.manage"),
            icon: "credit-card",
            style: :stripe,
            size: :md,
            type: "submit"
          ) %>
        <% end %>
      <% end %>
      <% if @show_see_usage %>
        <%= render FlatPack::Button::Component.new(
          text: t("recording_studio.stripe.billing.see_usage"),
          style: :secondary,
          size: :md,
          href: recording_studio_stripe.usage_path
        ) %>
      <% end %>
    </div>
  <% end %>

  <% if @lines.any? %>
    <% @lines.each do |line| %>
      <%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg) do %>
        <%= render RecordingStudioStripe::CurrentPlanComponent.new(
          subscription: line.subscription,
          can_manage: @show_manage_billing
        ) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: t("recording_studio.stripe.billing.empty_title"),
      description: t("recording_studio.stripe.billing.empty_description"),
      icon: :inbox
    ) do |empty| %>
      <% empty.item do %>
        <%= render FlatPack::Button::Component.new(
          text: t("recording_studio.stripe.billing.see_pricing"),
          style: :primary,
          size: :md,
          href: main_app.plans_path
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
