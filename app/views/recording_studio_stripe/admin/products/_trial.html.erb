<% if @kind != "allowance" && (@product.nil? || @product.plan?) %>
  <% trial = @product&.trial %>
  <% days_value = params.key?(:trial_days) ? params[:trial_days] : (trial&.offered? ? trial.days : nil) %>
  <% amount_value = params.key?(:trial_unit_amount) ? params[:trial_unit_amount] : (trial&.offered? ? trial.unit_amount : nil) %>
  <%= render FlatPack::SectionTitle::Component.new(title: t("recording_studio.stripe.admin.trial.title"), class: "my-0") %>
  <div class="flex flex-col gap-4">
    <%= render FlatPack::TextInput::Component.new(
      name: "trial_days",
      label: t("recording_studio.stripe.admin.trial.days"),
      value: days_value,
      placeholder: "14"
    ) %>
    <%= render FlatPack::TextInput::Component.new(
      name: "trial_unit_amount",
      label: t("recording_studio.stripe.admin.trial.amount_cents"),
      value: amount_value,
      placeholder: "100",
      help_text: t("recording_studio.stripe.admin.trial.help")
    ) %>
  </div>
<% end %>
