<% recording_studio_page_nav(
  title: t("recording_studio.stripe.admin.products.new_title"),
  page_nav_back_url: admin_screen_url("products"),
  page_nav_back_label: t("recording_studio.stripe.admin.nav.products")
) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: t("recording_studio.stripe.admin.products.new_title"),
    subtitle: t("recording_studio.stripe.admin.products.new_subtitle"),
    variant: :h1
  ) %>

  <%= form_with url: recording_studio_stripe.admin_products_path, method: :post, local: true, class: "flex max-w-xl flex-col gap-6" do %>
    <%= render FlatPack::Select::Component.new(
      name: "kind",
      label: t("recording_studio.stripe.admin.products.kind_label"),
      required: true,
      value: @kind,
      options: [
        [t("recording_studio.stripe.admin.products.kind_plan"), "plan"],
        [t("recording_studio.stripe.admin.products.kind_pack"), "allowance"]
      ]
    ) %>

    <%= render FlatPack::SectionTitle::Component.new(title: t("recording_studio.stripe.admin.products.this_plan"), class: "my-0") %>
    <div class="flex flex-col gap-4">
      <%= render FlatPack::TextInput::Component.new(
        name: "name",
        label: t("recording_studio.stripe.admin.common.name"),
        required: true,
        placeholder: t("recording_studio.stripe.admin.products.name_placeholder")
      ) %>
      <% if @kind != "allowance" %>
        <%= render FlatPack::TextInput::Component.new(
          name: "plan_card[subtitle]",
          label: t("recording_studio.stripe.admin.common.subtitle"),
          value: params.dig(:plan_card, :subtitle),
          placeholder: t("recording_studio.stripe.admin.products.subtitle_placeholder"),
          help_text: t("recording_studio.stripe.admin.products.subtitle_help")
        ) %>
      <% end %>
      <% if RecordingStudioStripe::SubscriptionTypes.configured? %>
        <%= render FlatPack::Select::Component.new(
          name: "subscription_type",
          label: t("recording_studio.stripe.admin.common.group"),
          required: true,
          value: params[:subscription_type].presence || RecordingStudioStripe::SubscriptionTypes.keys.first,
          options: RecordingStudioStripe::SubscriptionTypes.select_options
        ) %>
      <% end %>
      <%= render FlatPack::TextInput::Component.new(
        name: "description",
        label: t("recording_studio.stripe.admin.common.description"),
        placeholder: t("recording_studio.stripe.admin.products.description_placeholder")
      ) %>
    </div>

    <% if @kind != "allowance" %>
      <%= render FlatPack::SectionTitle::Component.new(title: t("recording_studio.stripe.admin.products.what_they_get"), class: "my-0") %>
      <div class="flex flex-col gap-4">
        <%= render "paywalls" %>
        <%= render "limits" %>
      </div>
      <%= render "trial" %>
      <%= render "plan_card" %>
    <% end %>
    <%= render FlatPack::Button::Component.new(
      text: t("recording_studio.stripe.admin.common.create"),
      style: :primary,
      size: :md,
      type: "submit"
    ) %>
  <% end %>
</div>
