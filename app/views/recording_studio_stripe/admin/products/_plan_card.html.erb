<% if @kind != "allowance" && (@product.nil? || @product.plan?) %>
  <% selected_type = @product&.subscription_type.presence || params[:subscription_type].presence || RecordingStudioStripe::SubscriptionTypes.keys.first %>
  <% settings = @product&.plan_card_settings || {} %>
  <% hidden = Array(settings["hide"]) %>
  <% extras = stripe_plan_card_extra_rows(settings) %>
  <%= render FlatPack::Collapse::Component.new(
    id: "pricing-card",
    title: t("recording_studio.stripe.admin.plan_card.title"),
    open: stripe_plan_card_open?(@product)
  ) do %>
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-2">
        <p class="text-sm font-medium text-[var(--surface-content-color)]"><%= t("recording_studio.stripe.admin.plan_card.hide_heading") %></p>
        <%= render FlatPack::Tooltip::Component.new(
          text: t("recording_studio.stripe.admin.plan_card.hide_tooltip"),
          placement: :top
        ) do %>
          <button type="button" class="inline-flex items-center text-[var(--surface-muted-content-color)]" aria-label="<%= t("recording_studio.stripe.admin.plan_card.hide_aria") %>">
            <%= render FlatPack::Shared::IconComponent.new(name: :question, size: :sm) %>
          </button>
        <% end %>
      </div>
      <% RecordingStudioStripe::PlanFeatures.hide_options(subscription_type: selected_type).each do |key, label| %>
        <%= render FlatPack::Checkbox::Component.new(
          name: "plan_card[hide][]",
          value: key,
          checked: hidden.include?(key),
          label: label
        ) %>
      <% end %>
      <%= render FlatPack::TextArea::Component.new(
        name: "plan_card[order]",
        label: t("recording_studio.stripe.admin.plan_card.custom_order"),
        value: Array(settings["order"]).join("\n"),
        rows: 4,
        placeholder: "limit:press_kits\nmeter:ai_tokens\npaywall:generate_image",
        help_text: t("recording_studio.stripe.admin.plan_card.custom_order_help")
      ) %>
      <p class="text-sm font-medium text-[var(--surface-content-color)]"><%= t("recording_studio.stripe.admin.plan_card.extra_line") %></p>
      <p class="text-sm text-[var(--surface-muted-content-color)]"><%= t("recording_studio.stripe.admin.plan_card.extra_line_help") %></p>
      <% extras.each_with_index do |extra, index| %>
        <%= hidden_field_tag "plan_card[extras][#{index}][key]", extra["key"] if extra["key"].present? %>
        <%= render FlatPack::TextInput::Component.new(
          name: "plan_card[extras][#{index}][text]",
          label: t("recording_studio.stripe.admin.plan_card.what_it_says"),
          value: extra["text"],
          placeholder: t("recording_studio.stripe.admin.plan_card.what_it_says_placeholder")
        ) %>
        <%= render FlatPack::TextInput::Component.new(
          name: "plan_card[extras][#{index}][icon]",
          label: t("recording_studio.stripe.admin.common.icon"),
          value: extra["icon"],
          placeholder: "star",
          help_text: t("recording_studio.stripe.admin.plan_card.icon_help")
        ) %>
      <% end %>
    </div>
  <% end %>
<% end %>
