<% if @kind != "allowance" && (@product.nil? || @product.plan?) %>
  <% selected_type = @product&.subscription_type.presence || params[:subscription_type].presence || RecordingStudioStripe::SubscriptionTypes.keys.first %>
  <% settings = @product&.plan_card_settings || {} %>
  <% hidden = Array(settings["hide"]) %>
  <% extras = stripe_plan_card_extra_rows(settings) %>
  <%= render FlatPack::Collapse::Component.new(
    id: "pricing-card",
    title: "Pricing card",
    open: stripe_plan_card_open?(@product)
  ) do %>
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-2">
        <p class="text-sm font-medium text-[var(--surface-content-color)]">Hide on the card</p>
        <%= render FlatPack::Tooltip::Component.new(
          text: "Hide a line on the card. The plan still includes it.",
          placement: :top
        ) do %>
          <button type="button" class="inline-flex items-center text-[var(--surface-muted-content-color)]" aria-label="About hiding lines">
            <%= render FlatPack::Shared::IconComponent.new(name: :question, size: :sm) %>
          </button>
        <% end %>
      </div>
      <% RecordingStudioStripe::PlanFeatures.hide_options(subscription_type: selected_type).each do |key, label| %>
        <%= render FlatPack::Checkbox::Component.new(
          name: "plan_card[hide][]",
          value: key,
          checked: hidden.include?(key),
          label: label
        ) %>
      <% end %>
      <%= render FlatPack::TextArea::Component.new(
        name: "plan_card[order]",
        label: "Custom order",
        value: Array(settings["order"]).join("\n"),
        rows: 4,
        placeholder: "limit:press_kits\nmeter:ai_tokens\npaywall:generate_image",
        help_text: "One line per row. Leave blank for the default order."
      ) %>
      <p class="text-sm font-medium text-[var(--surface-content-color)]">Extra line</p>
      <p class="text-sm text-[var(--surface-muted-content-color)]">Something the card should mention even if it does not unlock a feature.</p>
      <% extras.each_with_index do |extra, index| %>
        <%= hidden_field_tag "plan_card[extras][#{index}][key]", extra["key"] if extra["key"].present? %>
        <%= render FlatPack::TextInput::Component.new(
          name: "plan_card[extras][#{index}][text]",
          label: "What it says",
          value: extra["text"],
          placeholder: "We'll call you back today"
        ) %>
        <%= render FlatPack::TextInput::Component.new(
          name: "plan_card[extras][#{index}][icon]",
          label: "Icon",
          value: extra["icon"],
          placeholder: "star",
          help_text: "A Flatpack icon name. Blank is a check."
        ) %>
      <% end %>
    </div>
  <% end %>
<% end %>
