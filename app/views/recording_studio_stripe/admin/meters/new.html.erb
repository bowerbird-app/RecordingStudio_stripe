<% content_for :title, t("recording_studio.stripe.admin.meters.new_title") %>
<% content_for :subtitle, t("recording_studio.stripe.admin.meters.new_subtitle") %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: admin_screen_url("meters"),
  back_tooltip: t("recording_studio.stripe.admin.nav.meters")
) %>

<div class="flex w-full flex-col gap-6">
  <%= form_with url: recording_studio_stripe.admin_meters_path, method: :post, local: true, class: "flex max-w-xl flex-col gap-4" do %>
    <%= render FlatPack::TextInput::Component.new(
      name: "name",
      label: t("recording_studio.stripe.admin.common.name"),
      required: true,
      placeholder: "ai_tokens",
      help_text: t("recording_studio.stripe.admin.meters.name_help")
    ) %>
    <%= render FlatPack::TextInput::Component.new(
      name: "label",
      label: t("recording_studio.stripe.admin.common.label"),
      required: true,
      placeholder: t("recording_studio.stripe.admin.meters.label_placeholder")
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: t("recording_studio.stripe.admin.meters.create"),
      style: :primary,
      size: :md,
      type: "submit"
    ) %>
  <% end %>
</div>
