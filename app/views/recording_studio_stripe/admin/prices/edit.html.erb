<% content_for :title, t("recording_studio.stripe.admin.prices.edit_title") %>
<% content_for :subtitle, t("recording_studio.stripe.admin.prices.edit_subtitle") %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: admin_screen_url("prices"),
  back_tooltip: t("recording_studio.stripe.admin.nav.prices")
) %>

<div class="flex w-full flex-col gap-6">
  <%= form_with url: recording_studio_stripe.admin_price_path(@price), method: :patch, local: true, class: "flex max-w-xl flex-col gap-4" do %>
    <% if @product&.plan? %>
      <% RecordingStudioStripe::Meter.order(:name).each do |meter| %>
        <%= render FlatPack::TextInput::Component.new(
          name: "included[#{meter.name}]",
          label: t("recording_studio.stripe.admin.prices.included", label: meter.label.downcase),
          value: included_field_value(meter.name)
        ) %>
      <% end %>
    <% else %>
      <%= render FlatPack::Select::Component.new(
        name: "meter",
        label: t("recording_studio.stripe.admin.common.meter"),
        value: @price.allowance_meter_name,
        options: RecordingStudioStripe::Meter.order(:name).map { |meter| [meter.label, meter.name] }
      ) %>
      <%= render FlatPack::TextInput::Component.new(
        name: "allowance",
        label: t("recording_studio.stripe.admin.prices.allowance_quantity"),
        value: @price.allowance_quantity.positive? ? @price.allowance_quantity.to_s : nil
      ) %>
    <% end %>
    <%= render FlatPack::Button::Component.new(
      text: t("recording_studio.stripe.admin.prices.save"),
      style: :primary,
      size: :md,
      type: "submit"
    ) %>
  <% end %>
</div>
