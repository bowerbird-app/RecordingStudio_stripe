<% dummy_page_nav(title: "Studio Workspace", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: current_root_recording&.recordable&.try(:name) || "This workspace",
    subtitle: "Plans, usage, and Stripe billing for the selected workspace.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-2">
    <%= render FlatPack::Button::Component.new(text: "Plans", style: :primary, size: :md, href: plans_path) %>
    <%= render FlatPack::Button::Component.new(text: "Billing", style: :secondary, size: :md, href: recording_studio_stripe.root_path) %>
    <%= dummy_admin_button %>
  </div>

  <% handle = current_root_recording&.recordable&.billing %>
  <% subscription = handle&.subscription %>
  <% if subscription&.active? %>
    <%= render RecordingStudioStripe::CurrentPlanComponent.new(subscription: subscription) %>
    <%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg) do %>
      <% RecordingStudioStripe::Meter.order(:name).each do |meter| %>
        <%= render RecordingStudioStripe::MeterCardComponent.new(handle: handle.meter(meter.name)) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No plan on this workspace",
      description: "Pick Pro when you want included AI tokens and API calls. Extra packs sit on the billing page.",
      icon: :inbox
    ) do |empty| %>
      <% empty.slot do %>
        <%= render FlatPack::Button::Component.new(text: "See plans", style: :primary, size: :md, href: plans_path) %>
      <% end %>
    <% end %>
  <% end %>
</div>
