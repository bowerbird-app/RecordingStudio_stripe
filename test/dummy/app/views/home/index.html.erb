<% content_for :title, dummy_sidebar_title %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: dummy_sidebar_title,
    subtitle: dummy_home_subtitle,
    variant: :h1
  ) %>

  <% recordable = current_root_recording&.recordable %>
  <% if recordable.is_a?(AdminRoot) %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Staff desk",
      description: "Products and Prices live in Admin. Switch back to a workspace for customer billing.",
      icon: :inbox
    ) %>
  <% elsif dummy_home_plan_names.empty? %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No plan on this workspace",
      description: "Pick a plan when you want included usage. Billing keeps the meters.",
      icon: :inbox
    ) do |empty| %>
      <% empty.slot do %>
        <%= render FlatPack::Button::Component.new(text: "See plans", style: :primary, size: :md, href: plans_path) %>
      <% end %>
    <% end %>
  <% end %>
</div>
