<% dummy_page_nav(title: "Studio Workspace", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: current_root_recording&.recordable&.try(:name) || "This workspace",
    subtitle: "Plans, press kits, and billing for this workspace.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-2">
    <%= render FlatPack::Button::Component.new(text: "Plans", style: :primary, size: :md, href: plans_path) %>
    <%= render FlatPack::Button::Component.new(text: "Billing", style: :secondary, size: :md, href: recording_studio_stripe.root_path) %>
    <%= render FlatPack::Button::Component.new(text: "Public pricing", style: :ghost, size: :md, href: pricing_path) %>
    <%= dummy_admin_button %>
  </div>

  <% recordable = current_root_recording&.recordable %>
  <% handle = recordable.respond_to?(:billing) ? recordable.billing : nil %>
  <% lines = handle&.active_lines || [] %>
  <% if lines.any? %>
    <% lines.each do |line| %>
      <%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg) do %>
        <%= render RecordingStudioStripe::CurrentPlanComponent.new(subscription: line.subscription) %>
        <% billing_line_limits(line).each do |limit_handle| %>
          <%= render RecordingStudioStripe::LimitCardComponent.new(handle: limit_handle) %>
        <% end %>
      <% end %>
      <% meters = billing_line_meters(line) %>
      <% if meters.any? %>
        <%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg) do %>
          <% meters.each do |meter_handle| %>
            <%= render RecordingStudioStripe::MeterCardComponent.new(handle: meter_handle) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% elsif recordable.is_a?(AdminRoot) %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Staff desk",
      description: "Products and Prices live in Admin. Switch back to a workspace for customer billing.",
      icon: :inbox
    ) %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No plan on this workspace",
      description: "Pick Pro when you want included AI tokens and API calls. Extra packs sit on the billing page.",
      icon: :inbox
    ) do |empty| %>
      <% empty.slot do %>
        <%= render FlatPack::Button::Component.new(text: "See plans", style: :primary, size: :md, href: plans_path) %>
      <% end %>
    <% end %>
  <% end %>

  <% if dummy_show_press_kits? %>
    <%= render FlatPack::SectionTitle::Component.new(title: "Press kits", subtitle: dummy_press_kits_subtitle) %>
    <% kits = dummy_press_kit_recordings %>
    <% if kits.any? %>
      <%= render FlatPack::List::Component.new(divider: true) do %>
        <% kits.each do |recording| %>
          <%= render FlatPack::List::Item.new(icon: :queue_list) do %>
            <%= recording.recordable.name %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%= form_with url: press_kits_path, method: :post, local: true, class: "flex max-w-xl flex-col gap-4" do %>
      <%= render FlatPack::TextInput::Component.new(name: "name", label: "Name", required: true, placeholder: "Launch kit") %>
      <%= render FlatPack::Button::Component.new(text: "Add press kit", style: :primary, size: :md, type: "submit") %>
    <% end %>
  <% end %>

  <% paywalls = RecordingStudioStripe::Paywall.order(:name) %>
  <% if paywalls.any? && !recordable.is_a?(AdminRoot) %>
    <%= render FlatPack::PageTitle::Component.new(
      title: "What this plan opens",
      subtitle: lines.any? ? "On this workspace, with these plans." : "Pick a plan to open these.",
      variant: :h3
    ) %>
    <%= render FlatPack::ChipGroup::Component.new do %>
      <% paywalls.each do |paywall| %>
        <%= render FlatPack::Chip::Component.new(
          text: paywall.label,
          style: dummy_paywall_open?(paywall) ? :success : :default
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
