<!DOCTYPE html>
<html data-theme="rounded">
  <head>
    <% rs_config = RecordingStudio.configuration %>
    <% app_name = (rs_config.respond_to?(:app_name) ? rs_config.app_name : nil) || "Dummy" %>
    <title><%= content_for(:title).presence || app_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/rich_text", "data-turbo-track": "reload" %>
    <%= yield :head %>
    <%= javascript_importmap_tags if respond_to?(:javascript_importmap_tags) %>
  </head>

  <body class="bg-(--surface-page-background-color) text-(--surface-content-color)" data-dummy-sidebar-layout="true" data-theme="rounded">
    <%= render FlatPack::SidebarLayout::Component.new(storage_key: "dummy-sidebar") do |layout| %>
      <% layout.sidebar do %>
        <%= render "layouts/sidebar_nav" %>
      <% end %>

      <% layout.top_nav do %>
        <%= render "layouts/sidebar_top_nav" %>
      <% end %>

      <% layout.main do %>
        <main class="mx-auto w-full max-w-6xl p-6">
          <% if flash[:notice].present? %>
            <%= render FlatPack::Alert::Component.new(description: flash[:notice], style: :success, class: "mb-4") %>
          <% end %>
          <% if flash[:alert].present? %>
            <%= render FlatPack::Alert::Component.new(description: flash[:alert], style: :danger, class: "mb-4") %>
          <% end %>
          <%= yield %>
        </main>
      <% end %>
    <% end %>
  </body>
</html>
